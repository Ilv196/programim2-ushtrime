using System;

class Ushtrimi10
{
    static void Main()
    {
        Console.Write("Shkruaj nje numer: ");
        int num = Convert.ToInt32(Console.ReadLine());
        int factorial = 1;

        for (int i = 1; i <= num; i++)
        {
        factorial *= i;
        }

        Console.WriteLine($"Faktoriali i {num} eshte: {factorial}");
    }
}
