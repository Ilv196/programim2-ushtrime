using System;

class Ueshtrimi12
{
    static void Main()
    {
        Console.Write("Shkruaj nje numer (1-7): ");
        int day = Convert.ToInt32(Console.ReadLine());

        switch (day)
        {
            case 1:
                Console.WriteLine("E hene");
                break;
            case 2:
                Console.WriteLine("E marte");
                break;
            case 3:
                Console.WriteLine("E merkure");
                break;
            case 4:
                Console.WriteLine("E enjte");
                break;
            case 5:
                Console.WriteLine("E premte");
                break;
            case 6:
                Console.WriteLine("E shtune");
                break;
            case 7:
                Console.WriteLine("E diel");
                break;
            default:
                Console.WriteLine("Numer i pavlefshem.");
                break;
         }
    }
}
