using System;

class Ushtrimi11
{
    static void Main(string[]args)
    {
        Console.Write("Shkruaj nje string: ");
        string input = Console.ReadLine();
        string reversed = "";

        for (int i = input.Length - 1; i >= 0; i--)
        {
            reversed += input[i];
        }

        if (input == reversed)
        {
            Console.WriteLine("Stringu eshte palindrom.");
        }
        else
        {
            Console.WriteLine("Stringu nuk eshte palindrom.");
        }
     }
}
