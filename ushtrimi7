//Krijoni nje program, i cili i mundeson perdoruesit te jape te dhena rreth 3 librave, titulli, autori, cmimi, dhe me tej i afishon ato.

using System;
class SeminariI
{  
  static void Main()
    {
        string[] titulli = new string[3];
        string[] autori = new string[3];
        double[] cmimi = new double[3];

        for (int i = 0; i < 3; i++)
        {
            Console.WriteLine($"Jepni informacionin per librin {i + 1}:");

            Console.Write("Titulli: ");
            titulli[i] = Console.ReadLine();

            Console.Write("Autori: ");
            autori[i] = Console.ReadLine();

            Console.Write("Çmimi: ");
            cmimi[i] = double.Parse(Console.ReadLine());

            Console.WriteLine();
        }

        Console.WriteLine("Informacioni për librat:");
        for (int i = 0; i < 3; i++)
        {
            Console.WriteLine($"Librin {i + 1}:");
            Console.WriteLine($"Titulli: {titulli[i]}");
            Console.WriteLine($"Autori: {autori[i]}");
            Console.WriteLine($"Çmimi: {cmimi[i]}");
            Console.WriteLine();
        }
    }
}
