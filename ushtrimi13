using System;

class Ushtrimi13
{
    static void Main(string[]args)
    {
        Console.Write("Shkruani lartesine e piramides: ");
        int n = int.Parse(Console.ReadLine());

        for (int i = 1; i <= n; i++)
        {
  
            for (int j = 1; j <= i; j++)
            {
            Console.Write(j);
            }
          
            for (int j = i - 1; j >= 1; j--)
            {
            Console.Write(j);
            }
            Console.WriteLine();
        }
    }
}
