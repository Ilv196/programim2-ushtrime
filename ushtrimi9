using System;

class Ushtrimi9
{
    static void Main(string[]args)
    {
        Console.Write("Shkruaj nje numer: ");
        int num = Convert.ToInt32(Console.ReadLine());
        int reverse = 0;

        while (num != 0)
        {
        reverse = reverse * 10 + num % 10;
        num /= 10;
        }

        Console.WriteLine($"Numri i kthyer mbrapsht: {reverse}");
    }
}
